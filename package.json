{
  "name": "jongclub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:artifact": "vite build --mode artifact && node scripts/to-artifact.mjs && node scripts/pack-audio.mjs",
    "build:standalone": "vite build --mode standalone",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "server": "node server/index.js",
    "check:layout": "node scripts/check-layout.mjs"
  },
  "dependencies": {
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/three": "0.169.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^2.1.0"
  }
}
